# Meta (Facebook / Instagram)
MKT_META_ACCESS_TOKEN=
# Optional: enables appsecret_proof on every call
MKT_META_APP_SECRET=
MKT_META_AD_ACCOUNT_ID=act_123456789
# Required for organic posts and ad creatives:
MKT_META_PAGE_ID=
# Required for Instagram publishing:
MKT_META_IG_USER_ID=

# Google Ads — either a short-lived MKT_GOOGLE_ACCESS_TOKEN or the OAuth
# trio (client id/secret + refresh token); mkt exchanges the trio itself.
MKT_GOOGLE_ACCESS_TOKEN=
MKT_GOOGLE_DEVELOPER_TOKEN=
MKT_GOOGLE_CLIENT_ID=
MKT_GOOGLE_CLIENT_SECRET=
MKT_GOOGLE_REFRESH_TOKEN=
MKT_GOOGLE_CUSTOMER_ID=

# TikTok for Business
MKT_TIKTOK_ACCESS_TOKEN=
MKT_TIKTOK_ADVERTISER_ID=

# LinkedIn Marketing
MKT_LINKEDIN_ACCESS_TOKEN=
MKT_LINKEDIN_AD_ACCOUNT_ID=

# Config override
# MKT_CONFIG_DIR=/path/to/config
